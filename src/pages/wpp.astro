---
import MainLayoult from "../layouts/MainLayoult.astro";

const redirectTarget = "/";
---

<MainLayoult
  pathname="/wpp"
  imagePath="/social-share.jpg"
  noindex={true}
>
  <main
    style="min-height:100vh;display:grid;place-items:center;padding:2rem;background:#0f1113;color:#f5f5f5;text-align:center;"
  >
    <div style="max-width:40rem;">
      <h1 style="font-size:2rem;line-height:1.1;margin-bottom:1rem;">
        HJLOG Transportes
      </h1>
      <p style="font-size:1rem;line-height:1.6;opacity:0.85;margin-bottom:1.5rem;">
        Redirecionando para o site principal.
      </p>
      <a
        href={redirectTarget}
        style="display:inline-flex;align-items:center;justify-content:center;padding:0.85rem 1.4rem;border-radius:999px;background:#ff6b00;color:#111;font-weight:700;"
      >
        Abrir site
      </a>
    </div>
  </main>

  <script>
    if (typeof window !== "undefined") {
      window.location.replace("/");
    }
  </script>
</MainLayoult>
