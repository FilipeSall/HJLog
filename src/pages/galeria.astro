---
import MainLayoult from "../layouts/MainLayoult.astro";
import Header from "../components/layout/Header/Header.astro";
import Footer from "../components/layout/Footer/Footer.astro";

const galleryModules = import.meta.glob("../images/gallery/*.mp4", {
  eager: true,
  import: "default",
}) as Record<string, string>;

const stylePattern = [3, 2, 4, 3, 3, 2];

const labelOverrides: Record<string, { title: string; category: string }> = {
  "videoBackstage.mp4": { title: "Backstage de operação", category: "Estrutura" },
  "videoParceria.mp4": { title: "Parceria em campo", category: "Equipe" },
  "WhatsApp Video 2026-03-09 at 21.44.54.mp4": { title: "Rotina na estrada", category: "Rodoviário" },
  "prodEventosGrandes.mp4": { title: "Produção de grandes eventos", category: "Shows" },
  "showPlanejamento.mp4": { title: "Planejamento de shows", category: "Planejamento" },
  "hjlogLogistica.mp4": { title: "Operação logística HJLOG", category: "Logística" },
  "hjlogTerceirizacaoFrota.mp4": { title: "Terceirização de frota", category: "Frota" },
  "hjlogMagalu.mp4": { title: "Case de parceria Magalu", category: "Parceria" },
  "hjlogHistorico.mp4": { title: "Histórico de entregas", category: "Histórico" },
  "hjlogEsforço.mp4": { title: "Esforço de operação", category: "Execução" },
  "hjlogentrega.mp4": { title: "Entrega responsável", category: "Entrega" },
  "hjlogpreparado.mp4": { title: "Equipe preparada", category: "Equipe" },
};

const prettyLabelFromName = (filename: string) =>
  filename
    .replace(/\.mp4$/i, "")
    .replace(/^hjlog/i, "HJLOG ")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const galleryVideos = Object.entries(galleryModules)
  .sort(([a], [b]) => a.localeCompare(b, "pt-BR"))
  .map(([path, src], index) => {
    const filename = path.split("/").pop() ?? `video-${index + 1}.mp4`;
    const override = labelOverrides[filename];
    const fallbackTitle = prettyLabelFromName(filename);

    return {
      title: override?.title ?? fallbackTitle,
      category: override?.category ?? "Operação",
      src,
      span: stylePattern[index % stylePattern.length],
    };
  });
---

<MainLayoult>
  <Header />

  <main class="gallery-page">
    <section class="gallery-shell gallery-hero">
      <p class="gallery-eyebrow">Galeria HJLOG</p>
      <h1>Bastidores reais da nossa operação em movimento.</h1>
      <p>
        Um feed no estilo grade para navegar entre cenas de estrada, carregamento e parceria com clientes.
        Clique em qualquer vídeo para abrir em foco total.
      </p>
    </section>

    <section class="gallery-shell gallery-feed-section">
      <div class="gallery-grid">
        {
          galleryVideos.map((video, index) => (
            <button
              type="button"
              class="gallery-card"
              style={`--row-span: ${video.span}; --delay: ${index * 70}ms;`}
              data-gallery-card
              data-video-src={video.src}
              data-video-title={video.title}
              data-video-category={video.category}
            >
              <video
                class="gallery-card-video"
                src={video.src}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              />

              <span class="gallery-card-gradient" aria-hidden="true"></span>

              <div class="gallery-card-meta">
                <span>{video.category}</span>
                <strong>{video.title}</strong>
              </div>
            </button>
          ))
        }
      </div>
    </section>
  </main>

  <div id="gallery-modal" class="gallery-modal" aria-hidden="true">
    <button type="button" class="gallery-modal-overlay" data-gallery-close aria-label="Fechar galeria"></button>

    <video id="gallery-modal-background" class="gallery-modal-background" muted loop playsinline aria-hidden="true"></video>

    <div class="gallery-modal-content" role="dialog" aria-modal="true" aria-labelledby="gallery-modal-title">
      <button type="button" class="gallery-modal-close" data-gallery-close aria-label="Fechar">
        <span class="gallery-modal-close-icon" aria-hidden="true">×</span>
        <span class="gallery-modal-close-text">Fechar</span>
      </button>

      <div class="gallery-modal-player">
        <video id="gallery-modal-player" controls playsinline loop></video>
      </div>

      <div class="gallery-modal-footer">
        <p id="gallery-modal-category"></p>
        <h2 id="gallery-modal-title"></h2>
      </div>

      <div class="gallery-modal-nav">
        <button type="button" class="gallery-modal-nav-button" data-gallery-prev>
          <span>Voltar</span>
        </button>
        <button type="button" class="gallery-modal-nav-button" data-gallery-next>
          <span>Próximo</span>
        </button>
      </div>
    </div>
  </div>

  <Footer />
</MainLayoult>

<style>
  .gallery-page {
    min-height: 100vh;
    background:
      radial-gradient(1200px 500px at 20% -10%, rgba(255, 107, 0, 0.16), transparent 55%),
      radial-gradient(900px 480px at 100% 10%, rgba(255, 107, 0, 0.12), transparent 60%),
      var(--background-dark);
    padding-top: clamp(7.5rem, 12vw, 10rem);
    padding-bottom: var(--space-16);
  }

  .gallery-shell {
    margin: 0 auto;
    max-width: var(--container-max-width);
    padding-left: var(--container-padding-mobile);
    padding-right: var(--container-padding-mobile);
  }

  .gallery-hero {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
  }

  .gallery-eyebrow {
    color: var(--primary);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wider);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  .gallery-hero h1 {
    max-width: 20ch;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: var(--leading-tight);
  }

  .gallery-hero p {
    max-width: 65ch;
    color: var(--text-secondary-dark);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .gallery-grid {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 5.5rem;
  }

  .gallery-card {
    position: relative;
    grid-row: span var(--row-span);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #0e0e0e;
    cursor: pointer;
    animation: card-enter 500ms ease both;
    animation-delay: var(--delay);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .gallery-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 107, 0, 0.55);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .gallery-card-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform var(--transition-slow), filter var(--transition-base);
    filter: saturate(1.02) contrast(1.05);
  }

  .gallery-card:hover .gallery-card-video {
    transform: scale(1.09);
    filter: saturate(1.1) contrast(1.08);
  }

  .gallery-card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 12%, rgba(0, 0, 0, 0.15) 55%, transparent 100%);
  }

  .gallery-card-meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.85rem;
    display: grid;
    gap: 0.25rem;
    text-align: left;
  }

  .gallery-card-meta span {
    font-size: 0.7rem;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .gallery-card-meta strong {
    color: var(--text-primary-dark);
    font-size: var(--text-sm);
    line-height: 1.35;
    font-weight: var(--font-semibold);
  }

  .gallery-modal {
    position: fixed;
    inset: 0;
    z-index: 120;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .gallery-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .gallery-modal-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: none;
    background: rgba(0, 0, 0, 0.75);
    cursor: pointer;
  }

  .gallery-modal-background {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(28px) brightness(0.38);
    transform: scale(1.2);
    opacity: 0.88;
    pointer-events: none;
  }

  .gallery-modal-content {
    position: relative;
    z-index: 3;
    margin: 5vh auto 0;
    width: min(92vw, 440px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-sm);
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 0.95rem;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.58);
  }

  .gallery-modal-close {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.46rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.01));
    color: var(--text-primary-dark);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    transition: all var(--transition-base);
  }

  .gallery-modal-close:hover {
    border-color: var(--primary);
    color: var(--primary-hover);
    background: linear-gradient(145deg, rgba(255, 107, 0, 0.92), rgba(255, 107, 0, 0.7));
    box-shadow: 0 8px 18px rgba(255, 107, 0, 0.25);
  }

  .gallery-modal-close:active {
    filter: brightness(0.96);
  }

  .gallery-modal-close-icon {
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 2px;
    border: 1px solid currentColor;
    font-size: 0.85rem;
    line-height: 1;
  }

  .gallery-modal-close-text {
    line-height: 1;
  }

  .gallery-modal-player {
    margin-top: 0.6rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #050505;
  }

  .gallery-modal-player video {
    display: block;
    width: 100%;
    height: min(72vh, 650px);
    object-fit: cover;
  }

  .gallery-modal-footer {
    padding: 0.85rem 0.2rem 0.25rem;
    display: grid;
    gap: 0.15rem;
  }

  .gallery-modal-footer p {
    color: var(--primary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-weight: var(--font-semibold);
  }

  .gallery-modal-footer h2 {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    line-height: 1.25;
  }

  .gallery-modal-nav {
    display: flex;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-top: 0.35rem;
  }

  .gallery-modal-nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex: 1;
    border: 0;
    color: var(--text-primary-dark);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01));
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 0.62rem 0.75rem;
    transition: all var(--transition-base);
  }

  .gallery-modal-nav-button + .gallery-modal-nav-button {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .gallery-modal-nav-button:hover {
    color: var(--primary-hover);
    background: linear-gradient(145deg, rgba(255, 107, 0, 0.92), rgba(255, 107, 0, 0.72));
  }

  .gallery-modal-nav-button:active {
    filter: brightness(0.95);
  }

  .gallery-modal-nav-icon {
    display: inline-flex;
    align-items: center;
    font-size: 0.92rem;
    line-height: 1;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 768px) {
    .gallery-shell {
      padding-left: var(--container-padding-tablet);
      padding-right: var(--container-padding-tablet);
    }

    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 7rem;
      gap: 0.45rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-shell {
      padding-left: var(--container-padding-desktop);
      padding-right: var(--container-padding-desktop);
    }

    .gallery-grid {
      grid-auto-rows: 8rem;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    (() => {
      const cards = Array.from(document.querySelectorAll("[data-gallery-card]"));
      const modal = document.getElementById("gallery-modal");
      const modalPlayer = document.getElementById("gallery-modal-player");
      const modalBackground = document.getElementById("gallery-modal-background");
      const modalTitle = document.getElementById("gallery-modal-title");
      const modalCategory = document.getElementById("gallery-modal-category");
      const prevButton = document.querySelector("[data-gallery-prev]");
      const nextButton = document.querySelector("[data-gallery-next]");
      const closeButtons = document.querySelectorAll("[data-gallery-close]");

      if (
        !cards.length ||
        !modal ||
        !(modalPlayer instanceof HTMLVideoElement) ||
        !(modalBackground instanceof HTMLVideoElement) ||
        !modalTitle ||
        !modalCategory
      ) {
        return;
      }

      let activeIndex = -1;

      const syncVideos = (card) => {
        const { videoSrc, videoTitle, videoCategory } = card.dataset;
        if (!videoSrc) return;

        modalPlayer.src = videoSrc;
        modalBackground.src = videoSrc;

        modalTitle.textContent = videoTitle ?? "";
        modalCategory.textContent = videoCategory ?? "";
      };

      const openModal = (index) => {
        const targetCard = cards[index];
        if (!(targetCard instanceof HTMLElement)) return;

        activeIndex = index;
        syncVideos(targetCard);

        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        modalPlayer.currentTime = 0;
        modalPlayer.muted = false;
        modalPlayer.volume = 1;
        modalPlayer.play().catch(() => {});

        modalBackground.currentTime = 0;
        modalBackground.play().catch(() => {});
      };

      const closeModal = () => {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";

        modalPlayer.pause();
        modalBackground.pause();
      };

      const shiftVideo = (direction) => {
        if (!modal.classList.contains("is-open")) return;
        const nextIndex = (activeIndex + direction + cards.length) % cards.length;
        openModal(nextIndex);
      };

      cards.forEach((card, index) => {
        card.addEventListener("click", () => openModal(index));
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeModal);
      });

      prevButton?.addEventListener("click", () => shiftVideo(-1));
      nextButton?.addEventListener("click", () => shiftVideo(1));

      document.addEventListener("keydown", (event) => {
        if (!modal.classList.contains("is-open")) return;

        if (event.key === "Escape") {
          closeModal();
          return;
        }

        if (event.key === "ArrowLeft") {
          shiftVideo(-1);
          return;
        }

        if (event.key === "ArrowRight") {
          shiftVideo(1);
        }
      });
    })();
  }
</script>
