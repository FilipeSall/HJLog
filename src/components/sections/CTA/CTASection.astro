---
import { cta } from "../../../data/cta";
import { contato } from "../../../data/contato";
import CTABackground from "./CTABackground.astro";
import CTAPartners from "./CTAPartners.astro";
import ContactChannels from "../Contact/ContactChannels.astro";
import ContactForm from "../Contact/ContactForm.astro";
---

<section class="cta-section">
  <CTABackground />

  <div class="cta-container">
    <section class="contact-content-section">
      <div class="contact-content-container">
        <div class="contact-grid">
          <ContactChannels
            title={contato.channels.title}
            description={contato.channels.description}
            items={contato.channels.items}
          />

          <ContactForm
            title={contato.form.title}
            fields={contato.form.fields}
            submitLabel={contato.form.submitLabel}
          />
        </div>
      </div>
    </section>

    <CTAPartners
      title={cta.partnersTitle}
      partners={cta.partners}
    />
  </div>
</section>

<style>
  /* ===== Container da seção CTA ===== */
  .cta-section {
    position: relative;
    overflow: hidden;
    background-color: var(--surface-dark);
    padding: var(--space-24) 0;
  }

  /* Container principal */
  .cta-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--space-4);
    position: relative;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .cta-container {
      padding: 0 var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .cta-container {
      padding: 0 var(--space-8);
    }
  }

  .contact-content-section {
    margin-bottom: var(--space-16);
  }

  .contact-content-container {
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
