---
import { Icon } from "astro-icon/components";
import CustomSelectWhite from "./CustomSelectWhite.astro";

interface FormFields {
  name: {
    label: string;
    placeholder: string;
  };
  email: {
    label: string;
    placeholder: string;
  };
  subject: {
    label: string;
    options: string[];
  };
  message: {
    label: string;
    placeholder: string;
  };
}

interface Props {
  title: string;
  fields: FormFields;
  submitLabel: string;
}

const { title, fields, submitLabel } = Astro.props;
---

<div class="contact-form-wrapper">
  <h2 class="form-title">{title}</h2>
  <p class="form-subtitle">Canal direto com a equipe operacional. Retorno em at&eacute; 24h &uacute;teis.</p>
  <form class="contact-form">
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="name">{fields.name.label}</label>
        <input
          class="form-input"
          id="name"
          name="name"
          placeholder={fields.name.placeholder}
          type="text"
          required
        />
      </div>
      <div class="form-field">
        <label class="form-label" for="email">{fields.email.label}</label>
        <input
          class="form-input"
          id="email"
          name="email"
          placeholder={fields.email.placeholder}
          type="email"
          required
        />
      </div>
    </div>

    <div class="form-field">
      <CustomSelectWhite
        id="subject"
        label={fields.subject.label}
        options={fields.subject.options}
      />
    </div>

    <div class="form-field">
      <label class="form-label" for="message">{fields.message.label}</label>
      <textarea
        class="form-textarea"
        id="message"
        name="message"
        placeholder={fields.message.placeholder}
        rows="5"
        required
      ></textarea>
    </div>

    <div class="form-honeypot" aria-hidden="true">
      <label for="website">Website</label>
      <input
        id="website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <p class="form-feedback" aria-live="polite"></p>

    <button class="form-submit" type="submit">
      <span class="submit-label">{submitLabel}</span>
      <Icon name="mdi:send" size={20} class="submit-icon" />
    </button>
  </form>
</div>

<style>
  .contact-form-wrapper {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    background:
      linear-gradient(135deg, rgba(255, 107, 0, 0.14) 0%, rgba(255, 107, 0, 0) 42%),
      linear-gradient(180deg, rgba(24, 24, 24, 0.94) 0%, rgba(10, 10, 10, 0.97) 100%);
    padding: var(--space-8);
    border: 1px solid rgba(255, 107, 0, 0.24);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
    animation: formReveal 700ms ease-out both;
  }

  .contact-form-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.25;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent);
    z-index: 0;
  }

  .contact-form-wrapper::after {
    content: "";
    position: absolute;
    width: 14rem;
    height: 14rem;
    top: -7.5rem;
    right: -4rem;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255, 107, 0, 0.45) 0%, rgba(255, 107, 0, 0) 72%);
    filter: blur(10px);
    z-index: 0;
  }

  .contact-form-wrapper > * {
    position: relative;
    z-index: 1;
  }

  @keyframes formReveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-form-wrapper.form-flash {
    animation: flashBorder 3s ease-in-out;
  }

  @keyframes flashBorder {
    0%,
    100% {
      border-color: rgba(255, 107, 0, 0.24);
      box-shadow:
        0 24px 48px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    12%,
    32%,
    52%,
    72%,
    92% {
      border-color: var(--primary);
      box-shadow:
        0 0 0 1px rgba(255, 107, 0, 0.4),
        0 0 26px rgba(255, 107, 0, 0.5),
        0 24px 48px rgba(0, 0, 0, 0.45);
    }
    22%,
    42%,
    62%,
    82% {
      border-color: rgba(255, 107, 0, 0.24);
      box-shadow:
        0 24px 48px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
  }

  @media (min-width: 768px) {
    .contact-form-wrapper {
      padding: var(--space-10);
    }
  }

  .form-title {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: var(--font-bold);
    color: var(--text-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }

  .form-subtitle {
    color: rgba(242, 242, 242, 0.78);
    font-size: var(--text-sm);
    line-height: 1.55;
    margin-bottom: var(--space-10);
    max-width: 40ch;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(242, 242, 242, 0.72);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    background: rgba(12, 12, 12, 0.68);
    color: var(--text-primary-dark);
    padding: 0.85rem 1rem;
    outline: none;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 0;
    font-weight: var(--font-medium);
    font-family: var(--font-body);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base), transform var(--transition-fast);
    appearance: none;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: rgba(255, 107, 0, 0.75);
    background-color: rgba(15, 15, 15, 0.9);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.22);
    transform: translateY(-1px);
  }

  .form-input.error,
  .form-textarea.error {
    border-color: rgba(239, 68, 68, 0.9);
    background-color: rgba(59, 18, 18, 0.6);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
  }

  .form-input.error:focus,
  .form-textarea.error:focus {
    border-color: rgba(248, 113, 113, 0.95);
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.26);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(255, 255, 255, 0.44);
  }

  .form-select {
    color: var(--text-primary-dark);
  }

  .form-textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: var(--leading-relaxed);
  }

  .form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .form-feedback {
    min-height: 1.5rem;
    font-size: var(--text-sm);
    color: rgba(242, 242, 242, 0.72);
    margin-top: calc(var(--space-2) * -1);
    letter-spacing: 0.01em;
  }

  .form-feedback.is-success {
    color: #6ee7b7;
  }

  .form-feedback.is-error {
    color: #fca5a5;
  }

  .form-submit {
    margin-top: var(--space-4);
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: linear-gradient(120deg, #ff6b00 0%, #ff8a33 52%, #ffbc8d 140%);
    color: #111111;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    padding: 0.95rem var(--space-8);
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    transition: transform var(--transition-base), box-shadow var(--transition-base), filter var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    box-shadow:
      0 10px 20px rgba(255, 107, 0, 0.24),
      0 2px 0 rgba(255, 255, 255, 0.32) inset;
  }

  .form-submit::before {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 70%;
    height: 100%;
    background: linear-gradient(95deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-22deg);
    transition: left 520ms ease;
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .form-submit:hover {
    transform: translateY(-2px);
    box-shadow:
      0 14px 26px rgba(255, 107, 0, 0.32),
      0 2px 0 rgba(255, 255, 255, 0.32) inset;
    filter: brightness(1.04);
  }

  .form-submit:hover::before {
    left: 145%;
  }

  .submit-icon {
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .form-submit:hover .submit-icon {
    transform: translateX(0.28rem);
    opacity: 0.9;
  }

  @media (max-width: 767px) {
    .contact-form-wrapper {
      border-radius: 0;
      padding: var(--space-6);
    }

    .form-submit {
      padding-inline: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form-wrapper,
    .form-submit,
    .submit-icon,
    .form-input,
    .form-select,
    .form-textarea {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { sendLeadEmail } from '../../../lib/email';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('.contact-form') as HTMLFormElement;
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const messageInput = document.getElementById('message') as HTMLTextAreaElement;
    const honeypotInput = document.getElementById('website') as HTMLInputElement;
    const submitButton = form?.querySelector('.form-submit') as HTMLButtonElement;
    const submitLabelElement = submitButton?.querySelector('.submit-label') as HTMLSpanElement;
    const feedbackElement = form?.querySelector('.form-feedback') as HTMLParagraphElement;
    const originalSubmitLabel = submitLabelElement?.textContent?.trim() || 'Enviar';

    if (!form) return;

    const setFeedback = (message: string, state: 'success' | 'error' | 'neutral' = 'neutral') => {
      if (!feedbackElement) return;

      feedbackElement.textContent = message;
      feedbackElement.classList.remove('is-success', 'is-error');

      if (state === 'success') feedbackElement.classList.add('is-success');
      if (state === 'error') feedbackElement.classList.add('is-error');
    };

    const setSubmitting = (isSubmitting: boolean) => {
      if (submitButton) submitButton.disabled = isSubmitting;
      if (submitLabelElement) {
        submitLabelElement.textContent = isSubmitting ? 'Enviando...' : originalSubmitLabel;
      }
    };

    const validateField = (input: HTMLInputElement | HTMLTextAreaElement): boolean => {
      const value = input.value.trim();

      if (!value) {
        input.classList.add('error');
        return false;
      }

      if (input.type === 'email') {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          input.classList.add('error');
          return false;
        }
      }

      input.classList.remove('error');
      return true;
    };

    const addBlurValidation = (input: HTMLInputElement | HTMLTextAreaElement) => {
      input.addEventListener('blur', () => {
        validateField(input);
      });

      input.addEventListener('input', () => {
        if (input.classList.contains('error') && input.value.trim()) {
          validateField(input);
        }
      });
    };

    if (nameInput) addBlurValidation(nameInput);
    if (emailInput) addBlurValidation(emailInput);
    if (messageInput) addBlurValidation(messageInput);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setFeedback('');

      const subjectHiddenInput = form.querySelector('input[name="subject"]') as HTMLInputElement;
      const subject = subjectHiddenInput?.value || '';

      const isNameValid = validateField(nameInput);
      const isEmailValid = validateField(emailInput);
      const isMessageValid = validateField(messageInput);


      if (!isNameValid || !isEmailValid || !isMessageValid || !subject) {
        setFeedback('Preencha todos os campos obrigatórios corretamente.', 'error');
        return;
      }

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();
      const details = `
Tipo: Contato Geral
Assunto: ${subject}

Mensagem:
${message}
      `.trim();

      setSubmitting(true);

      const result = await sendLeadEmail(
        {
          name,
          email,
          subject: `[CONTATO SITE] ${subject} - ${name}`,
          message: details,
          source: 'contact-form'
        },
        {
          honeypot: honeypotInput?.value ?? ''
        }
      );

      setSubmitting(false);

      if (!result.ok) {
        if (result.errorCode === 'rate_limited') {
          setFeedback('Aguarde 1 minuto antes de enviar novamente.', 'error');
          return;
        }

        if (result.errorCode === 'spam_detected') {
          setFeedback('Não foi possível processar o envio.', 'error');
          return;
        }

        setFeedback('Falha ao enviar. Tente novamente em instantes.', 'error');
        return;
      }

      setFeedback('Mensagem enviada com sucesso. Nossa equipe retornará em breve.', 'success');
      form.reset();
      nameInput.classList.remove('error');
      emailInput.classList.remove('error');
      messageInput.classList.remove('error');
    });
  });
</script>
