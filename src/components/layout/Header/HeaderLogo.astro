---
import logo from "../../../images/newlogo.webp";
import { Image } from "astro:assets";
---

<div class="header-logo">
  <a href="/" class="logo-link">
    <Image
      src={logo}
      alt="HJLOG Logo"
      class="logo-img"
      loading="eager"
      decoding="async"
      width={220}
      height={88}
    />
  </a>
</div>

<style>
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-img {
    height: 3.75rem;
    width: auto;
  }

  @media (min-width: 768px) {
    .logo-img {
      height: 4.5rem;
    }
  }
</style>
