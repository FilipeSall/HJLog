---
import { Icon } from "astro-icon/components";

interface Link {
  label: string;
  href: string;
  external?: boolean;
  icon?: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const currentPath = Astro.url.pathname;
const isGalleryPage = currentPath.startsWith("/galeria");

const isActive = (href: string) => {
  if (!href.startsWith("/")) return false;
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<div class="header-links">
  {
    isGalleryPage && (
      <a href="/" class="home-link" aria-label="Início" title="Início">
        Início
      </a>
    )
  }
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class={isActive(link.href) ? "nav-link nav-link-active" : "nav-link"}
        aria-label={link.label}
        title={link.label}
      >
        {link.icon ? <Icon name={link.icon} class="nav-icon" aria-hidden="true" /> : link.label}
      </a>
    ))
  }
</div>

<style>
  .header-links {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .home-link,
  .home-link:visited {
    color: var(--text-secondary-dark);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .home-link:hover,
  .home-link:focus-visible {
    color: var(--text-primary-dark);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    font-size: 1.75rem;
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-icon {
    width: 1em;
    height: 1em;
  }

  .nav-link-active {
    color: var(--text-primary-dark);
  }

  .nav-link-active:hover {
    color: var(--primary);
  }

  .nav-link:not(.nav-link-active) {
    color: var(--text-secondary-dark);
  }

  .nav-link:not(.nav-link-active):hover {
    color: var(--text-primary-dark);
  }

  /* Consultas de mídia */
  @media (min-width: 768px) {
    .header-links {
      display: flex;
    }
  }
</style>
