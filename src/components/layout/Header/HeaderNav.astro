---
import { Icon } from "astro-icon/components";

interface Link {
  label: string;
  href: string;
  external?: boolean;
  icon?: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const currentPath = Astro.url.pathname;
const isGalleryPage = currentPath.startsWith("/galeria");

const isActive = (href: string) => {
  if (!href.startsWith("/")) return false;
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<div class="header-links">
  {
    isGalleryPage && (
      <a href="/" class="home-link" aria-label="Início" title="Início">
        <Icon name="mdi:home-outline" class="nav-icon" aria-hidden="true" />
        <span class="nav-label">Início</span>
      </a>
    )
  }
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class={isActive(link.href) ? "nav-link nav-link-active" : "nav-link"}
        aria-label={link.label}
        title={link.label}
      >
        {link.icon && <Icon name={link.icon} class="nav-icon" aria-hidden="true" />}
        <span class="nav-label">{link.label}</span>
      </a>
    ))
  }
</div>

<style>
  .header-links {
    display: none;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    background: linear-gradient(120deg, rgba(17, 17, 17, 0.88), rgba(28, 28, 28, 0.82));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  .home-link,
  .home-link:visited,
  .nav-link,
  .nav-link:visited {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary-dark);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    padding: 0.625rem 0.95rem;
    background: transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .nav-label {
    white-space: nowrap;
  }

  .home-link:hover,
  .home-link:focus-visible,
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text-primary-dark);
    border-color: rgba(255, 107, 0, 0.28);
    background: linear-gradient(120deg, rgba(255, 107, 0, 0.16), rgba(255, 107, 0, 0.03));
    transform: translateY(-1px);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .home-link:focus-visible,
  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 107, 0, 0.35);
  }

  .nav-link-active,
  .home-link {
    color: var(--text-primary-dark);
  }

  .nav-link-active,
  .home-link {
    border-color: rgba(255, 107, 0, 0.2);
    background: linear-gradient(120deg, rgba(255, 107, 0, 0.14), rgba(255, 107, 0, 0.02));
  }

  .nav-link-active:hover,
  .home-link:hover {
    border-color: rgba(255, 107, 0, 0.45);
    box-shadow: 0 8px 22px -16px rgba(255, 107, 0, 0.8);
  }

  /* Consultas de mídia */
  @media (min-width: 768px) {
    .header-links {
      display: flex;
    }
  }
</style>
