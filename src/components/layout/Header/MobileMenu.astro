---
import { Icon } from "astro-icon/components";

interface Link {
  label: string;
  href: string;
  external?: boolean;
  icon?: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const currentPath = Astro.url.pathname;
const isGalleryPage = currentPath.startsWith("/galeria");

const isActive = (href: string) => {
  if (!href.startsWith("/")) return false;
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<div id="mobile-menu" class="mobile-menu">
  <div class="mobile-menu-links">
    {
      isGalleryPage && (
        <a href="/" class="nav-link" aria-label="Início" title="Início">
          <Icon name="mdi:home-outline" class="nav-icon" aria-hidden="true" />
          <span class="nav-label">Início</span>
        </a>
      )
    }
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class={isActive(link.href) ? "nav-link nav-link-active" : "nav-link"}
          aria-label={link.label}
          title={link.label}
        >
          {link.icon && <Icon name={link.icon} class="nav-icon" aria-hidden="true" />}
          <span class="nav-label">{link.label}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: linear-gradient(160deg, rgba(17, 17, 17, 0.98), rgba(21, 21, 21, 0.96));
    border-bottom: 1px solid var(--border-dark);
    padding: 1rem 1rem 1.25rem;
    animation: fadeIn var(--transition-base);
  }

  .mobile-menu-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-default);
    background: linear-gradient(120deg, rgba(17, 17, 17, 0.9), rgba(28, 28, 28, 0.84));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  .mobile-menu--open {
    display: flex;
  }

  .nav-link,
  .nav-link:visited {
    flex: 1 1 calc(50% - 0.4rem);
    min-width: 8.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--text-secondary-dark);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    padding: 0.7rem 1rem;
    background: transparent;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .nav-label {
    white-space: nowrap;
  }

  .nav-link-active {
    color: var(--text-primary-dark);
    border-color: rgba(255, 107, 0, 0.2);
    background: linear-gradient(120deg, rgba(255, 107, 0, 0.14), rgba(255, 107, 0, 0.02));
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text-primary-dark);
    border-color: rgba(255, 107, 0, 0.32);
    background: linear-gradient(120deg, rgba(255, 107, 0, 0.18), rgba(255, 107, 0, 0.04));
    transform: translateY(-1px);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 107, 0, 0.35);
  }

  .nav-link-active:hover {
    border-color: rgba(255, 107, 0, 0.45);
    box-shadow: 0 8px 22px -16px rgba(255, 107, 0, 0.8);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Consultas de mídia */
  @media (min-width: 768px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>
